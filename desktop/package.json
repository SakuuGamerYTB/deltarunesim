{
  "name": "deltarune-fight-simulator",
  "version": "0.9.14",
  "description": "Offline DELTARUNE and UNDERTALE battle simulator",
  "author": "SakuuGamerYTB",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test content.test.cjs",
    "build:windows": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sakuugamerytb.deltarunesim",
    "productName": "DELTARUNE Fight Simulator",
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.cjs",
      "content.cjs",
      "smoke.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site"
      },
      {
        "from": "../readable",
        "to": "readable"
      },
      {
        "from": "../README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DELTARUNE-Simulator-${version}-Windows-Standalone.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user",
      "useZip": true
    }
  }
}
